---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign core_pages = '/,/blog/,/storage/,/categories/,/about/,/expertise/,/series/strix-halo/,/resources.html,/useful-commands.html,/documents/resume.html,/documents/portfolio.html,/documents/publications.html,/documents/contact-info.html,/privacy/' | split: ',' %}
  {% for core_url in core_pages %}
    {% assign matched_page = site.pages | where: 'url', core_url | first %}
  <url>
    <loc>{{ core_url | absolute_url }}</loc>
    {% if matched_page.last_modified_at %}<lastmod>{{ matched_page.last_modified_at | date_to_xmlschema }}</lastmod>{% elsif matched_page.date %}<lastmod>{{ matched_page.date | date_to_xmlschema }}</lastmod>{% endif %}
  </url>
  {% endfor %}

  {% for post in site.posts %}
    {% unless post.sitemap == false or post.robots contains 'noindex' %}
  <url>
    <loc>{{ post.url | absolute_url }}</loc>
    <lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod>
  </url>
    {% endunless %}
  {% endfor %}
</urlset>
